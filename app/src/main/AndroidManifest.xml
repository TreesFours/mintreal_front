<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.mistreal_mini">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only needed for gallery-save (ScreenshotHelper.saveToGallery) on API 28
         and below — MediaStore's scoped storage on API 29+ needs no permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Watch Hub screen-share host: required by Android 14+ (API 34) when a
         foreground service declares foregroundServiceType="mediaProjection". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- SfxHapticPlayer's toggle/alert vibration (SOS alert in particular). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Watch Hub Phase 3 — Nearby Connections (Bluetooth/Wi-Fi-Direct
         signaling transport). BLUETOOTH/BLUETOOTH_ADMIN cover API <=30;
         the three ADVERTISE/CONNECT/SCAN permissions are the API 31+
         (Android 12) runtime-permission replacements Nearby Connections
         needs for the same operations. neverForLocation is accurate here —
         this app already asks for real location elsewhere for its own
         features, but Nearby's BLE scan specifically never uses location. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:targetApi="31" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- ResourceMonitor: network-type/metered signal for adaptive degradation. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ (API 33) replacement for Wi-Fi-based Nearby discovery. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:targetApi="33" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".MistrealApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mistreal_mini"
        android:enableOnBackInvokedCallback="true">

        <service
            android:name=".service.VoiceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

        <service
            android:name=".service.WatchHostService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".ui.startup.PhoenixBootActivity"
            android:exported="false"
            android:theme="@style/Theme.Mistreal_mini" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mistreal_mini"
            android:configChanges="orientation|screenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 🔗 Secure Verified Social Connection App Link -->
            <intent-filter android:autoVerify="true" android:label="Mistreal Social Link">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="mistreal-backend.onrender.com" />
                <data android:pathPrefix="/social-connected" />
            </intent-filter>

            <!-- 🔗 Legacy Custom Scheme Fallback -->
            <intent-filter android:label="Mistreal Legacy Social Link">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mistreal" />
                <data android:host="social-connected" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.stealth.StealthActivity"
            android:exported="false"
            android:theme="@style/Theme.Mistreal_mini"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
