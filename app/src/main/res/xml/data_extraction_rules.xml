<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <!-- 🛡️ Do not include any database files in automatic cloud backup -->
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <!-- 🛡️ Do not include any database files in device-to-device transfers -->
    </device-transfer>
</data-extraction-rules>